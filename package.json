{
  "name": "testcafe-testing",
  "version": "1.0.0",
  "description": "testcafe automation practiced",
  "keywords": [
    "TestCafe",
    "Testing",
    "Automation"
  ],
  "license": "ISC",
  "author": "Juan Martinez",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:chrome": "testcafe chrome ./tests -s takeOnFails=true",
    "test:chrome:headless": "testcafe chrome:headless ./tests -s takeOnFails=true",
    "test:chrome:mobile": "testcafe chrome:emulation:device=iPhone X ./tests -s takeOnFails=true",
    "test:safari": "testcafe safari ./tests -s takeOnFails=true",
    "test:firefox": "testcafe firefox ./tests -s takeOnFails=true",
    "test:chrome:Login": "testcafe chrome ./tests/login.test.js -s takeOnFails=true",
    "test:chrome:pay": "testcafe chrome ./tests/new-pay.test.js -s takeOnFails=true",
    "test:chrome:search": "testcafe chrome ./tests/search.test.js -s takeOnFails=true",
    "test:chrome:forgotten": "testcafe chrome ./tests/forgotten-password.test.js -s takeOnFails=true",
    "test:chrome:feedback": "testcafe chrome ./tests/feedback.test.js -s takeOnFails=true"
  },
  "dependencies": {
    "prettier": "^3.9.10",
    "testcafe": "^3.7.6"
  }
}
